[Unit]
Description=rtech-agents agentd for agent %i (managed engine session over NATS)
After=network-online.target
Wants=network-online.target
# Bound the OUTER systemd restart loop. The inner supervisor circuit exits
# non-zero when its restart budget is spent (#84 slice A); Restart=on-failure
# would otherwise relaunch that forever. StartLimit caps it: at most 5 starts
# per 300s window, after which systemd holds the unit in failed state until an
# operator intervenes (systemctl reset-failed). Inner circuit + outer StartLimit
# together are the true bound — see docs/canary-rollback-runbook.md.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/rtech-agents
EnvironmentFile=%h/rtech-agents/.env
Environment=RTECH_AGENT_ID=%i
# Scrub the cc-env poison: ~/.cc-env pins stale 4-6-era ANTHROPIC_* values that
# route the SDK engine through a LiteLLM proxy and break real-engine turns. The
# env -u wrapper strips them from the child so the engine uses the box's
# subscription CLI auth with its own model defaults (issue #55).
ExecStart=/usr/bin/env -u ANTHROPIC_BASE_URL -u ANTHROPIC_API_KEY -u ANTHROPIC_MODEL -u ANTHROPIC_DEFAULT_OPUS_MODEL -u ANTHROPIC_DEFAULT_SONNET_MODEL uv run --frozen python -m rtech_agentd
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
