# WATCHER-CANARY orchestrator env — the derived-done coordinator that fans a
# debate frame verbatim to each participant's task lane. Lines go into the shared
# ~/rtech-agents/.env. See deploy/kboard/watcher-canary.md.
#
# The orchestrator MUST ship from a build with the TASK_INGRESS fan-out consumer
# and an rtech-frames build that decodes origin/debate (SCHEMA_VERSION 6). On
# origin/main today (PRs #98-#104) it does — that is the atomic-ship requirement
# from deploy/kboard/README.md ("Trio-intake debate: orchestrator must ship
# atomically"). Upgrade rtech-frames + orchestrator + agentd together, then
# enable chatd debate participants.

# --- NATS (coordination plane) -----------------------------------------------
# Orchestrator reads NATS_URL (shared with agentd). Authed coordination cluster.
NATS_URL=nats://127.0.0.1:4223

# --- stack stamp (REQUIRED, issue #75) ---------------------------------------
# Ingress guard: the orchestrator ONLY consumes TaskFrames whose stack matches.
# No default — MUST equal the chatd + agentd RTECH_STACK_ID. If unset the
# orchestrator fails loudly at startup (resolve_stack_id).
RTECH_STACK_ID=canary

# --- single-scope routing target (REQUIRED) ----------------------------------
# The agentd id that scope=single tasks route to. No hardcoded literal — unset
# fails loudly (resolve_target_agent_id). For the trio canary the debate is
# multi-scope (fanned by TASK_INGRESS), but a single-scope target is still
# required config; point it at the triage agent.
RTECH_TARGET_AGENT_ID=agentd-nagatha
# Back-compat alias (accepted if RTECH_TARGET_AGENT_ID is unset):
# RTECH_SINGLE_AGENT_ID=agentd-nagatha

# --- bridged agents (optional, PR #73) ---------------------------------------
# Fleet ids fronted by a hermes bridge. Not used for the pure-agentd trio canary
# (all three participants are native agentd instances). Leave UNSET.
# RTECH_BRIDGED_AGENTS=
