# WATCHER-CANARY chatd edge env — trio-debate in a fresh no-agents channel.
# Copy the relevant lines into ~/rtech-agents/.env on the k-board host and fill.
# NEVER commit a filled .env. Secret VALUES come from Vaultwarden; only *_ref
# indirection lives here. See deploy/kboard/watcher-canary.md.
#
# This edge is a DEDICATED WATCHER bot (its own Discord app), NOT any Hermes
# agent bot. It listens in ONE fresh channel that has no Hermes agents present,
# mints a duo/trio debate TaskFrame from each intake hit, and renders each
# participant's turn back — a stance TLDR in the channel plus full text in one
# lazily-created "debate <task_id>" thread.

# --- NATS (coordination plane) -----------------------------------------------
# The authed fleet-js coordination cluster. Chatd reads RTECH_CHATD_NATS_URL;
# it defaults to the live fleet bus when unset (see rtech_chatd.config
# DEFAULT_NATS_URL). Point it at the authed cluster for the canary.
RTECH_CHATD_NATS_URL=nats://127.0.0.1:4223
# NATS credentials are supplied to the process by the deploy wiring, NOT written
# as a literal here. If your fleet-nats build reads a creds file, reference it by
# PATH via the process env the unit already loads; never inline a credential.
# (fleet-nats resolves auth from its own env/creds ref — see fleet-bus config.)

# --- stack stamp (REQUIRED, issue #75) ---------------------------------------
# Every TaskFrame this edge publishes is stamped with the stack id; the
# orchestrator only consumes matching tasks. No default — MUST match the
# orchestrator's RTECH_STACK_ID. Use a dedicated canary stack so the watcher
# never cross-consumes the live 'dev' stack.
RTECH_STACK_ID=canary

# --- bot token (REQUIRED, ref only) ------------------------------------------
# Indirection ref naming the env var WHERE the WATCHER bot token VALUE lives.
# Only an `env:VAR` ref is accepted at runtime — rtech_chatd.config.validate_token_ref
# fails closed on a literal or a `vaultwarden:` ref, without echoing the value.
# The operator SOURCES the secret from Vaultwarden but INJECTS it into the env var
# this ref names at install time; configure `env:VAR`, never `vaultwarden:<item>`.
RTECH_CHATD_TOKEN_REF=env:RTECH_CHATD_BOT_TOKEN
# The token VALUE, fetched from Vaultwarden by the operator and written into
# ~/rtech-agents/.env, NEVER committed.
# Vaultwarden ref: rtech-agents/kboard/RTECH_WATCHER_BOT_TOKEN
# RTECH_CHATD_BOT_TOKEN=

# --- inbox channel (REQUIRED) ------------------------------------------------
# The fresh no-agents channel's id. This is the ONLY channel where the watcher
# answers without an @mention ("treat Discord as leaked"). Set it to the new
# channel you created for the trio test.
RTECH_CHATD_INBOX_CHANNEL=

# --- bot-author policy -------------------------------------------------------
# none | mentions. `all` is REJECTED fail-closed. For a human-driven trio test
# leave it at the default (none) — no other bot's message is ever an intake hit.
# RTECH_CHATD_ALLOW_BOTS=none

# --- INTAKE (REQUIRED to fire the trio debate, issue #93) --------------------
# Intake is OFF unless enabled. When on, a message is a HIT iff it @mentions a
# configured member id OR contains a configured name trigger as a whole word OR
# begins with a configured trigger prefix. There is NO LLM classification — pure
# string/id matching (rtech_chatd.config.IntakeConfig).
RTECH_CHATD_INTAKE_ENABLED=1
# Channel scope: listed | all-channels. The fresh channel IS the inbox
# (free-response) channel, so `listed` already scopes intake to it — keep the
# blast radius to the one canary channel.
RTECH_CHATD_INTAKE_MODE=listed
# The triage agent id a hit dispatches to. REQUIRED when intake is enabled — a
# blank value fails closed. MUST be a deployed agentd-<name> id (matches an
# agentd's RTECH_AGENT_ID), and MUST be one of RTECH_CHATD_DEBATE_PARTICIPANTS
# below. Nagatha is the triage voice.
RTECH_CHATD_TRIAGE_AGENT=agentd-nagatha
# Optional hit triggers. Any ONE of these firing makes a message an intake hit.
# For the trio test, a name trigger or a prefix is the simplest human entry.
# Comma-separated Discord user/bot ids whose @mention is a hit:
# RTECH_CHATD_INTAKE_MEMBER_IDS=
# Comma-separated case-insensitive whole-word name tokens:
RTECH_CHATD_INTAKE_NAME_TRIGGERS=debate,trio
# Comma-separated literal prefixes (message starts-with, case-insensitive):
RTECH_CHATD_INTAKE_TRIGGER_PREFIXES=!debate

# --- DEBATE fanout (REQUIRED for the trio, issue #93) ------------------------
# The ordered agentd ids a hit fans out to as a REAL multi-participant debate.
# COUNT derives scope: 2=duo, 3=trio. Order is preserved (it is the typed
# participant identity the orchestrator fans out in). Every id MUST match
# ^agentd-[a-z0-9][a-z0-9-]*$, and RTECH_CHATD_TRIAGE_AGENT MUST be one of them.
# UNSET/empty would collapse to single-scope intake (Nagatha only) — that is the
# "only Nagatha responded" failure mode. Set all three for the trio.
RTECH_CHATD_DEBATE_PARTICIPANTS=agentd-nagatha,agentd-bilby,agentd-skippy

# --- home channel (optional) -------------------------------------------------
# Not needed for the trio test. Leave unset.
# DISCORD_HOME_CHANNEL=
