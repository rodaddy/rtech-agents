# WATCHER-CANARY tgd Telegram edge env — trio-debate in a fresh Telegram group.
# Copy the relevant lines into ~/rtech-agents/.env on the k-board host and fill.
# NEVER commit a filled .env. Secret VALUES come from Vaultwarden; only *_ref
# indirection lives here. See deploy/kboard/watcher-canary.md (Telegram section).
#
# This edge is the standalone `rtech-tgd` service: a DEDICATED WATCHER Telegram
# bot (its own BotFather app), NOT any Hermes agent bot. It long-polls ONE fresh
# supergroup, mints a duo/trio debate TaskFrame from each intake hit, and renders
# each participant's turn back UNDER THAT PARTICIPANT'S OWN BOT (multi-identity),
# with full text in a per-agent forum topic lane.
#
# Long polling: there is NO inbound port, NO webhook, NO public domain. The edge
# reaches OUT to api.telegram.org; nothing reaches in.

# --- NATS (coordination plane) -----------------------------------------------
# The authed fleet-js coordination cluster. tgd reads RTECH_CHATD_NATS_URL; it
# defaults to the live fleet bus when unset (see rtech_chatd.telegram_service
# DEFAULT_NATS_URL). Point it at the same bus every role in this canary uses.
RTECH_CHATD_NATS_URL=nats://127.0.0.1:4223
# NATS credentials are supplied to the process by the deploy wiring, NOT written
# as a literal here (fleet-nats resolves auth from its own env/creds ref).

# --- stack stamp (REQUIRED) ---------------------------------------
# Every TaskFrame this edge publishes is stamped with the stack id; the
# orchestrator only consumes matching tasks. No default — MUST match the
# orchestrator's RTECH_STACK_ID. Use a dedicated canary stack so the watcher
# never cross-consumes the live 'dev' stack.
RTECH_STACK_ID=canary

# --- polling bot token (REQUIRED, ref only) ----------------------------------
# Indirection ref naming WHERE the WATCHER polling-bot token lives (env: only).
# NEVER a literal token — validate_token_ref fails closed on a
# literal WITHOUT echoing it. This bot runs getUpdates and posts the unstamped
# (edge-identity) acks; per-agent debate voices come from the identity map below.
RTECH_CHATD_TOKEN_REF=env:RTECH_CHATD_BOT_TOKEN
# The token VALUE, fetched from Vaultwarden by the operator and written into
# ~/rtech-agents/.env, NEVER committed.
# Vaultwarden ref: <your-secret-store-path>/RTECH_TG_WATCHER_BOT_TOKEN
# RTECH_CHATD_BOT_TOKEN=

# --- group allowlist (REQUIRED, ids only) ------------------------------------
# Canonical signed-integer Telegram chat ids the edge accepts (a supergroup is a
# '-100…' id). REQUIRED for the standalone edge: an empty allowlist would answer
# in EVERY group the bot is added to (security floor: treat chat as leaked), so a
# set-but-empty or missing value fails closed at startup. Comma-separated. Chat
# ids are opaque public ids, not secrets.
RTECH_TG_ALLOWED_GROUPS=-1001234567890

# --- multi-identity sender pool (REQUIRED for the trio, refs only) -----------
# agentd-<name>=<token_ref> pairs binding each debate voice to its OWN bot token
# ref, so a participant's turn renders under that bot's name (attribution IS the
# posting bot; the edge sets attributed=False). Every value is a *_ref
# indirection — a literal on EITHER side fails closed WITHOUT echoing. Every
# agent id MUST match ^agentd-[a-z0-9][a-z0-9-]*$. When debate participants are
# configured, every participant needs a mapped, provisioned env ref before
# ingress starts; unset is only the single-bot, no-debate path.
RTECH_TG_IDENTITY_MAP=agentd-nimbus=env:RTECH_TG_TOKEN_NIMBUS,agentd-birk=env:RTECH_TG_TOKEN_BIRK,agentd-sprocket=env:RTECH_TG_TOKEN_SPROCKET
# The per-identity token VALUES, from Vaultwarden, written into the env vars the
# refs above name. NEVER committed. Vaultwarden refs:
#   <your-secret-store-path>/RTECH_TG_TOKEN_NIMBUS
#   <your-secret-store-path>/RTECH_TG_TOKEN_BIRK
#   <your-secret-store-path>/RTECH_TG_TOKEN_SPROCKET
# RTECH_TG_TOKEN_NIMBUS=
# RTECH_TG_TOKEN_BIRK=
# RTECH_TG_TOKEN_SPROCKET=

# --- long-poll hold (optional) -----------------------------------------------
# getUpdates server-side long-poll hold in seconds. Default 30. Must be >= 1 (a
# 0 hold hot-loops the poll); a malformed value fails closed naming the var. The
# adapter derives its HTTP request_timeout as hold + buffer, so a long hold can
# never outlive the HTTP timeout.
# RTECH_TG_POLL_TIMEOUT_S=30

# --- INTAKE (REQUIRED to fire the trio debate) --------------------
# Intake is OFF unless enabled. When on, a message is a HIT iff it @mentions a
# configured member id OR contains a configured name trigger as a whole word OR
# begins with a configured trigger prefix. NO LLM classification — pure matching.
RTECH_CHATD_INTAKE_ENABLED=1
# Channel scope: listed | all-channels. In listed mode, every configured
# RTECH_TG_ALLOWED_GROUPS chat is in scope; no separate inbox variable is used.
RTECH_CHATD_INTAKE_MODE=listed
# The triage agent id a hit dispatches to. REQUIRED when intake is enabled — a
# blank value fails closed. MUST be a deployed agentd-<name> id AND one of
# RTECH_CHATD_DEBATE_PARTICIPANTS below. Nimbus is the triage voice.
RTECH_CHATD_TRIAGE_AGENT=agentd-nimbus
# Optional hit triggers (any ONE firing makes a message an intake hit):
# Comma-separated Telegram user/bot ids whose @mention is a hit:
# RTECH_CHATD_INTAKE_MEMBER_IDS=
# Comma-separated case-insensitive whole-word name tokens:
RTECH_CHATD_INTAKE_NAME_TRIGGERS=debate,trio
# Comma-separated literal prefixes (message starts-with, case-insensitive):
RTECH_CHATD_INTAKE_TRIGGER_PREFIXES=!debate

# --- DEBATE fanout (REQUIRED for the trio) ------------------------
# The ordered agentd ids a hit fans out to as a REAL multi-participant debate.
# COUNT derives scope: 2=duo, 3=trio. Order is preserved (typed participant
# identity). Every id MUST match ^agentd-[a-z0-9][a-z0-9-]*$, and
# RTECH_CHATD_TRIAGE_AGENT MUST be one of them. UNSET collapses to single-scope
# intake (Nimbus only) — the "only Nimbus responded" failure mode.
RTECH_CHATD_DEBATE_PARTICIPANTS=agentd-nimbus,agentd-birk,agentd-sprocket

# --- per-agent forum-topic lanes (optional, chat-scoped) ---------------------
# Bind each agent's full debate text to a persistent forum topic per chat, so the
# same voice routes to a DIFFERENT topic id in each group. Shape:
# <chat_id>:<agentd-name>=<topic_id>,... Chat ids are signed integers; topic ids
# are positive integers. A malformed entry is skipped with a sanitized warning,
# never accepted. Unset = a lazily-created per-turn thread (default).
# RTECH_CHATD_DEBATE_CHAT_LANES=-1001234567890:agentd-nimbus=2,-1001234567890:agentd-birk=3,-1001234567890:agentd-sprocket=4
# Legacy single-group agent->topic map (superseded by the chat-scoped map above):
# RTECH_CHATD_DEBATE_LANES=agentd-nimbus=2,agentd-birk=3,agentd-sprocket=4
